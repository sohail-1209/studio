
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================================
    // == CHATS COLLECTION RULES ==
    // ================================================================================
    match /chats/{chatId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.userIds);
      allow create: if request.auth != null && request.auth.uid in request.resource.data.userIds;
      allow update: if request.auth != null && request.auth.uid in resource.data.userIds;
      // allow delete: if request.auth != null && request.auth.uid in resource.data.userIds; // Optional

      match /messages/{messageId} {
        allow read: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.userIds.hasAny([request.auth.uid]);
        allow create: if request.auth != null &&
                         request.auth.uid == request.resource.data.senderId &&
                         get(/databases/$(database)/documents/chats/$(chatId)).data.userIds.hasAny([request.auth.uid]);
        allow delete: if request.auth != null &&
                         request.auth.uid == resource.data.senderId &&
                         get(/databases/$(database)/documents/chats/$(chatId)).data.userIds.hasAny([request.auth.uid]);
      }
    }
    // ================================================================================
    // == END OF CHATS COLLECTION RULES ==
    // ================================================================================

    // ================================================================================
    // == FOLLOW REQUESTS COLLECTION RULES ==
    // ================================================================================
    match /followRequests/{requestId} {
      allow read: if request.auth != null &&
                    (request.auth.uid == resource.data.requesterId || request.auth.uid == resource.data.recipientId);

      allow create: if request.auth != null &&
                     request.auth.uid == request.resource.data.requesterId &&
                     request.resource.data.status == 'pending' &&
                     request.resource.data.requesterId != request.resource.data.recipientId;

      allow update: if request.auth != null &&
                     request.auth.uid == resource.data.recipientId &&
                     request.resource.data.status != resource.data.status &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if request.auth != null &&
                     (
                       (request.auth.uid == resource.data.requesterId &&
                        (resource.data.status == 'pending' || resource.data.status == 'declined' || resource.data.status == 'accepted'))
                       ||
                       (request.auth.uid == resource.data.recipientId &&
                        (resource.data.status == 'accepted' || resource.data.status == 'declined'))
                     );
    }
    // ================================================================================
    // == END OF FOLLOW REQUESTS COLLECTION RULES ==
    // ================================================================================

    // Posts collection
    match /posts/{postId} {
      // UPDATED Post Read Rule:
      allow read: if resource.data.authorIsPrivate == false || resource.data.authorIsPrivate == null // Public post or old post without the field
                     || (resource.data.authorIsPrivate == true &&
                         request.auth != null && // Ensure user is authenticated to check follow status
                         (
                           resource.data.userId == request.auth.uid || // Author can always read their own posts
                           (
                             // Check if an accepted follow request exists from current user to post author
                             exists(/databases/$(database)/documents/followRequests/$(request.auth.uid)_$(resource.data.userId)) &&
                             get(/databases/$(database)/documents/followRequests/$(request.auth.uid)_$(resource.data.userId)).data.status == 'accepted'
                           )
                         )
                        );

      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;

      allow update: if request.auth != null &&
                      (
                        // Owner can update non-counter fields
                        (request.auth.uid == resource.data.userId &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likesCount', 'likedBy', 'commentsCount'])) ||
                        // Any authenticated user can update counter fields (e.g., liking a post)
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy'])) ||
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount']))
                      );

      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read: if true; // Comments are readable if the post is readable (implicitly handled by post read rule)
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
        // UPDATED Comment Delete Rule:
        allow delete: if request.auth != null &&
                         (
                           request.auth.uid == resource.data.userId || // Comment owner
                           request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId // Post owner
                         );
      }
    }

    // Profiles collection
    match /profiles/{userId} {
      allow read: if request.auth != null; // Basic auth check for reading any profile
      allow create: if request.auth != null && request.auth.uid == userId; // User can create their own profile
      allow delete: if request.auth != null && request.auth.uid == userId; // User can delete their own profile
      allow update: if request.auth != null &&
                     (
                       // Profile owner can update their own non-sensitive fields (including isPrivate)
                       (request.auth.uid == userId &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'followersCount', 'followingCount']))
                       ||
                       // Profile owner can update their own followersCount
                       (request.auth.uid == userId &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount']))
                       ||
                       // Profile owner can update their own followingCount
                       (request.auth.uid == userId &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followingCount']))
                     );
    }

    // Notifications collection
    match /notifications/{notificationId} {
        allow read, update: if request.auth != null && request.auth.uid == resource.data.recipientId;
        // UPDATED Notification Delete Rule:
        allow delete: if request.auth != null &&
                         (request.auth.uid == resource.data.recipientId || request.auth.uid == resource.data.actorId);

        allow create: if request.auth != null &&
                       request.resource.data.actorId == request.auth.uid &&
                       request.resource.data.actorId != request.resource.data.recipientId &&
                       (
                         ( request.resource.data.type == 'like' &&
                           request.resource.data.postId != null
                         ) ||
                         ( request.resource.data.type == 'comment' &&
                           request.resource.data.postId != null &&
                           request.resource.data.commentText != null
                         ) ||
                         ( request.resource.data.type == 'follow_request' &&
                           request.resource.data.followRequestId != null
                         ) ||
                         ( request.resource.data.type == 'follow_accept' &&
                           request.resource.data.originalFollowRequestId != null
                         )
                       );
    }
  }
}
