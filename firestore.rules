
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isProfileEffectivelyPublic(userId) {
      // A profile is effectively public if it doesn't exist (edge case, less likely for authors),
      // or its 'isPrivate' field is false, or 'isPrivate' field doesn't exist.
      return !exists(/databases/$(database)/documents/profiles/$(userId)) ||
             get(/databases/$(database)/documents/profiles/$(userId)).data.isPrivate == false ||
             !( 'isPrivate' in get(/databases/$(database)/documents/profiles/$(userId)).data );
    }

    function isProfilePrivate(userId) {
      return exists(/databases/$(database)/documents/profiles/$(userId)) &&
             get(/databases/$(database)/documents/profiles/$(userId)).data.isPrivate == true;
    }

    function isAcceptedFollower(profileOwnerId, requesterId) {
      // Checks if a 'followRequests' document exists where the requester is following the profileOwner
      // and the status is 'accepted'.
      // Ensures the document being checked corresponds to the correct requester and recipient.
      return request.auth != null && requesterId == request.auth.uid && // Requester must be the authenticated user
             exists(/databases/$(database)/documents/followRequests/$(requesterId)_$(profileOwnerId)) &&
             get(/databases/$(database)/documents/followRequests/$(requesterId)_$(profileOwnerId)).data.status == 'accepted' &&
             get(/databases/$(database)/documents/followRequests/$(requesterId)_$(profileOwnerId)).data.requesterId == requesterId &&
             get(/databases/$(database)/documents/followRequests/$(requesterId)_$(profileOwnerId)).data.recipientId == profileOwnerId;
    }
    // End of Helper Functions

    // ================================================================================
    // == CHATS COLLECTION RULES ==
    // ================================================================================
    match /chats/{chatId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.userIds);
      allow create: if request.auth != null &&
                       request.auth.uid in request.resource.data.userIds &&
                       request.resource.data.userIds.size() == 2 && // Ensure only two users
                       // Ensure userDetails exist for both users
                       request.resource.data.userDetails[request.resource.data.userIds[0]] != null &&
                       request.resource.data.userDetails[request.resource.data.userIds[1]] != null;
      allow update: if request.auth != null && request.auth.uid in resource.data.userIds;

      match /messages/{messageId} {
        allow read: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.userIds.hasAny([request.auth.uid]);
        allow create: if request.auth != null &&
                         request.auth.uid == request.resource.data.senderId &&
                         get(/databases/$(database)/documents/chats/$(chatId)).data.userIds.hasAny([request.auth.uid]) &&
                         // Ensure text or imageUrl is present
                         (request.resource.data.text != null || request.resource.data.imageUrl != null);
        allow delete: if request.auth != null &&
                         request.auth.uid == resource.data.senderId &&
                         get(/databases/$(database)/documents/chats/$(chatId)).data.userIds.hasAny([request.auth.uid]);
      }
    }
    // ================================================================================
    // == END OF CHATS COLLECTION RULES ==
    // ================================================================================

    // ================================================================================
    // == FOLLOW REQUESTS COLLECTION RULES ==
    // ================================================================================
    match /followRequests/{requestId} {
      allow read: if request.auth != null &&
                    (request.auth.uid == resource.data.requesterId || request.auth.uid == resource.data.recipientId);

      allow create: if request.auth != null &&
                     request.auth.uid == request.resource.data.requesterId &&
                     request.resource.data.requesterId != request.resource.data.recipientId &&
                     // Fields check
                     request.resource.data.requesterId != null &&
                     request.resource.data.recipientId != null &&
                     request.resource.data.status != null &&
                     // Logic based on target profile privacy
                     (
                       (isProfilePrivate(request.resource.data.recipientId) && request.resource.data.status == 'pending') ||
                       (isProfileEffectivelyPublic(request.resource.data.recipientId) && request.resource.data.status == 'accepted')
                     );

      allow update: if request.auth != null &&
                     (
                       // Recipient accepting/declining a pending request
                       (
                         request.auth.uid == resource.data.recipientId &&
                         resource.data.status == 'pending' &&
                         (request.resource.data.status == 'accepted' || request.resource.data.status == 'declined') &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                       ) ||
                       // Requester updating their own request to 'accepted' if target is public (e.g., profile switched from private to public)
                       // This is less common, usually a new 'accepted' request is created if re-following a public profile.
                       (
                         request.auth.uid == resource.data.requesterId &&
                         isProfileEffectivelyPublic(resource.data.recipientId) &&
                         request.resource.data.status == 'accepted' &&
                         resource.data.status != 'accepted' && // Only if not already accepted
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                       )
                     );

      allow delete: if request.auth != null &&
                     (
                       // Requester can delete their request if it's pending, or if it's accepted (unfollow)
                       (request.auth.uid == resource.data.requesterId &&
                        (resource.data.status == 'pending' || resource.data.status == 'accepted'))
                       ||
                       // Recipient can delete a request they've processed (declined), or an accepted one (if they remove a follower - less common client op)
                       (request.auth.uid == resource.data.recipientId &&
                        (resource.data.status == 'declined' || resource.data.status == 'accepted'))
                     );
    }
    // ================================================================================
    // == END OF FOLLOW REQUESTS COLLECTION RULES ==
    // ================================================================================

    // Posts collection
    match /posts/{postId} {
      allow read: if
        // Case 1: Post is explicitly marked public AND author's profile is effectively public
        (
          resource.data.authorIsPrivate == false && isProfileEffectivelyPublic(resource.data.userId)
        ) ||
        // Case 2: Current user is the author of the post
        (
          request.auth != null && request.auth.uid == resource.data.userId
        ) ||
        // Case 3: Post's author's profile is private, and current user is an accepted follower
        (
          resource.data.authorIsPrivate == true && // Post marked as from private author
          isProfilePrivate(resource.data.userId) && // Author's profile is actually private
          request.auth != null &&
          isAcceptedFollower(resource.data.userId, request.auth.uid)
        );

      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.userId &&
                       request.resource.data.caption != null &&
                       // Ensure either imageUrl or caption is present, or it's a story (which might just have an image)
                       (request.resource.data.imageUrl != null || request.resource.data.caption != null || request.resource.data.isStory == true) &&
                       request.resource.data.userId != null &&
                       request.resource.data.likesCount == 0 &&
                       request.resource.data.commentsCount == 0;


      allow update: if request.auth != null &&
                      (
                        // Owner can update caption, image, etc., but NOT counters directly
                        (request.auth.uid == resource.data.userId &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likesCount', 'likedBy', 'commentsCount', 'userId', 'createdAt', 'authorIsPrivate'])) ||
                        // Anyone authenticated can update like/comment counters (usually via increments)
                        // This is a simplified rule; ideally increments are validated more strictly.
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy', 'commentsCount']))
                      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read: if true; // Comments are public if the post is readable
        allow create: if request.auth != null &&
                         request.auth.uid == request.resource.data.userId &&
                         request.resource.data.text != null &&
                         request.resource.data.userId != null;
        allow delete: if request.auth != null &&
                         (request.auth.uid == resource.data.userId || // Comment owner
                          request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId); // Post owner
      }
    }

    // Profiles collection
    match /profiles/{userId} {
      // MODIFIED: Allow reading public profiles by anyone, and any profile by authenticated users.
      allow read: if
        (isProfileEffectivelyPublic(userId)) || // Anyone can read a public profile
        (request.auth != null);                 // Authenticated users can read any profile (including private ones, e.g. for DMs)

      allow create: if request.auth != null &&
                       request.auth.uid == userId &&
                       request.resource.data.uid == userId &&
                       request.resource.data.email != null &&
                       request.resource.data.displayName != null &&
                       request.resource.data.username != null &&
                       request.resource.data.followersCount == 0 &&
                       request.resource.data.followingCount == 0 &&
                       request.resource.data.isPrivate == false; // Default to public on creation

      allow update: if request.auth != null && request.auth.uid == userId &&
                       // Prevent changing UID, email, or other critical fields that should be immutable or server-controlled
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'email']) &&
                       // Allow owner to update their own followingCount (e.g., by increment(1))
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followingCount']) ||
                       // Allow owner to update their own followersCount (e.g., by increment(1) from a function)
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount']) ||
                       // Allow owner to update other allowed fields
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['followersCount', 'followingCount']));


      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Notifications collection
    match /notifications/{notificationId} {
        allow read, update: if request.auth != null && request.auth.uid == resource.data.recipientId;
        allow delete: if request.auth != null && request.auth.uid == resource.data.recipientId;

        allow create: if request.auth != null &&
                       request.resource.data.actorId == request.auth.uid &&
                       request.resource.data.actorId != request.resource.data.recipientId &&
                       request.resource.data.type != null &&
                       request.resource.data.recipientId != null &&
                       (
                         ( request.resource.data.type == 'like' &&
                           request.resource.data.postId != null
                         ) ||
                         ( request.resource.data.type == 'comment' &&
                           request.resource.data.postId != null &&
                           request.resource.data.commentText != null
                         ) ||
                         ( request.resource.data.type == 'follow_request' &&
                           request.resource.data.followRequestId != null &&
                           isProfilePrivate(request.resource.data.recipientId) // Only send follow_request notif if target is private
                         ) ||
                         ( request.resource.data.type == 'follow_accept' &&
                           request.resource.data.originalFollowRequestId != null
                         )
                       );
    }
  }
}

    