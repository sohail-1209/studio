
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================================
    // == CHATS COLLECTION RULES ==
    // ================================================================================
    match /chats/{chatId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.userIds);
      allow create: if request.auth != null && request.auth.uid in request.resource.data.userIds;
      allow update: if request.auth != null && request.auth.uid in resource.data.userIds;
      // allow delete: if request.auth != null && request.auth.uid in resource.data.userIds; // Optional

      match /messages/{messageId} {
        allow read: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.userIds.hasAny([request.auth.uid]);
        allow create: if request.auth != null &&
                         request.auth.uid == request.resource.data.senderId &&
                         get(/databases/$(database)/documents/chats/$(chatId)).data.userIds.hasAny([request.auth.uid]);
        allow delete: if request.auth != null &&
                         request.auth.uid == resource.data.senderId &&
                         get(/databases/$(database)/documents/chats/$(chatId)).data.userIds.hasAny([request.auth.uid]);
      }
    }
    // ================================================================================
    // == END OF CHATS COLLECTION RULES ==
    // ================================================================================

    // ================================================================================
    // == FOLLOW REQUESTS COLLECTION RULES ==
    // ================================================================================
    match /followRequests/{requestId} {
      allow read: if request.auth != null &&
                    (request.auth.uid == resource.data.requesterId || request.auth.uid == resource.data.recipientId);

      allow create: if
        request.auth != null &&
        request.auth.uid == request.resource.data.requesterId &&
        request.resource.data.requesterId != request.resource.data.recipientId &&
        (
          // Case 1: Target profile is explicitly private, request status must be 'pending'
          (
            get(/databases/$(database)/documents/profiles/$(request.resource.data.recipientId)).data.isPrivate == true &&
            request.resource.data.status == 'pending'
          )
          ||
          // Case 2: Target profile is public (isPrivate is false OR isPrivate field is missing), request status must be 'accepted'
          (
            (
              get(/databases/$(database)/documents/profiles/$(request.resource.data.recipientId)).data.isPrivate == false ||
              !( 'isPrivate' in get(/databases/$(database)/documents/profiles/$(request.resource.data.recipientId)).data )
            ) &&
            request.resource.data.status == 'accepted'
          )
        );

      allow update: if request.auth != null &&
                     request.auth.uid == resource.data.recipientId &&
                     request.resource.data.status != resource.data.status &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if request.auth != null &&
                     (
                       (request.auth.uid == resource.data.requesterId &&
                        (resource.data.status == 'pending' || resource.data.status == 'declined' || resource.data.status == 'accepted'))
                       ||
                       (request.auth.uid == resource.data.recipientId &&
                        (resource.data.status == 'accepted' || resource.data.status == 'declined'))
                     );
    }
    // ================================================================================
    // == END OF FOLLOW REQUESTS COLLECTION RULES ==
    // ================================================================================

    // Posts collection
    match /posts/{postId} {
      allow read: if (resource.data.authorIsPrivate == false || resource.data.authorIsPrivate == null) ||
                     (request.auth != null && resource.data.authorIsPrivate == true &&
                       (
                         (exists(/databases/$(database)/documents/followRequests/$(request.auth.uid)_$(resource.data.userId)) &&
                          get(/databases/$(database)/documents/followRequests/$(request.auth.uid)_$(resource.data.userId)).data.status == 'accepted')
                         ||
                         resource.data.userId == request.auth.uid
                       )
                     );

      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;

      allow update: if request.auth != null &&
                      (
                        // Owner can update non-counter fields and their own visibility flag
                        (request.auth.uid == resource.data.userId &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likesCount', 'likedBy', 'commentsCount'])) ||
                        // Any authenticated user can update interaction counts
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy'])) ||
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount']))
                      );

      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
        // Allow comment deletion by comment author OR post owner
        allow delete: if request.auth != null &&
                         (request.auth.uid == resource.data.userId ||
                          request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId);
      }
    }

    // Profiles collection
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
			allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null &&
                     (
                       (request.auth.uid == userId &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'followersCount', 'followingCount']))
                       ||
                       (
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount']) && request.auth.uid == userId) ||
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followingCount']) && request.auth.uid == userId)
                       )
                     );
    }

    // Notifications collection
    match /notifications/{notificationId} {
        allow read, update: if request.auth != null && request.auth.uid == resource.data.recipientId;
        // Allow deletion by recipient OR actor (for cleanup during account deletion)
        allow delete: if request.auth != null && (request.auth.uid == resource.data.recipientId || request.auth.uid == resource.data.actorId);

        allow create: if request.auth != null &&
                       request.resource.data.actorId == request.auth.uid &&
                       request.resource.data.actorId != request.resource.data.recipientId &&
                       (
                         ( request.resource.data.type == 'like' &&
                           request.resource.data.postId != null
                         ) ||
                         ( request.resource.data.type == 'comment' &&
                           request.resource.data.postId != null &&
                           request.resource.data.commentText != null
                         ) ||
                         ( request.resource.data.type == 'follow_request' &&
                           request.resource.data.followRequestId != null
                         ) ||
                         ( request.resource.data.type == 'follow_accept' &&
                           request.resource.data.originalFollowRequestId != null
                         )
                       );
    }
  }
}
