
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isProfileEffectivelyPublic(userId) {
      let profileData = get(/databases/$(database)/documents/profiles/$(userId)).data;
      return profileData.isPrivate == false || !('isPrivate' in profileData);
    }

    function isProfileActuallyPrivate(userId) {
      return exists(/databases/$(database)/documents/profiles/$(userId)) &&
             get(/databases/$(database)/documents/profiles/$(userId)).data.isPrivate == true;
    }

    function isAcceptedFollower(profileOwnerId, requesterId) {
      let followDocId = requesterId + '_' + profileOwnerId;
      return request.auth != null && requesterId == request.auth.uid &&
             exists(/databases/$(database)/documents/followRequests/$(followDocId)) &&
             get(/databases/$(database)/documents/followRequests/$(followDocId)).data.status == 'accepted' &&
             get(/databases/$(database)/documents/followRequests/$(followDocId)).data.requesterId == requesterId &&
             get(/databases/$(database)/documents/followRequests/$(followDocId)).data.recipientId == profileOwnerId;
    }

    function isValidGroupUserDetails(userIds, userDetails) {
      return userIds.size() == userDetails.keys().size() &&
             userIds.all(uid => userDetails[uid].displayName != null);
             // photoURL can be null, so not checking it here
    }

    function allMembersTypingFalse(userIds, typingMap) {
      return userIds.all(uid => typingMap[uid] == false);
    }
    // End of Helper Functions

    // ================================================================================
    // == CHATS COLLECTION RULES ==
    // ================================================================================
    match /chats/{chatId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.userIds);

      allow create: if request.auth != null &&
                       request.auth.uid in request.resource.data.userIds &&
                       (
                         // 1-on-1 Chat
                         ( (request.resource.data.isGroupChat == false || !('isGroupChat' in request.resource.data)) &&
                           request.resource.data.userIds.size() == 2 &&
                           request.resource.data.userDetails[request.resource.data.userIds[0]].displayName != null &&
                           request.resource.data.userDetails[request.resource.data.userIds[1]].displayName != null &&
                           // Ensure typing field is initialized correctly for 1-on-1
                           request.resource.data.typing.keys().hasOnly(request.resource.data.userIds) &&
                           request.resource.data.typing[request.resource.data.userIds[0]] == false &&
                           request.resource.data.typing[request.resource.data.userIds[1]] == false
                         ) ||
                         // Group Chat
                         ( request.resource.data.isGroupChat == true &&
                           request.resource.data.userIds.size() >= 2 && // Groups must have at least 2 members
                           request.resource.data.groupName != null && request.resource.data.groupName.size() > 0 &&
                           isValidGroupUserDetails(request.resource.data.userIds, request.resource.data.userDetails) &&
                           // Ensure typing field is initialized correctly for groups
                           request.resource.data.typing.keys().hasOnly(request.resource.data.userIds) &&
                           allMembersTypingFalse(request.resource.data.userIds, request.resource.data.typing)
                         )
                       );

      allow update: if request.auth != null && request.auth.uid in resource.data.userIds;

      match /messages/{messageId} {
        allow read: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.userIds.hasAny([request.auth.uid]);
        allow create: if request.auth != null &&
                         request.auth.uid == request.resource.data.senderId &&
                         get(/databases/$(database)/documents/chats/$(chatId)).data.userIds.hasAny([request.auth.uid]) &&
                         (request.resource.data.text != null || request.resource.data.imageUrl != null) &&
                         request.resource.data.senderId != null;
        allow delete: if request.auth != null &&
                         request.auth.uid == resource.data.senderId &&
                         get(/databases/$(database)/documents/chats/$(chatId)).data.userIds.hasAny([request.auth.uid]);
      }
    }
    // ================================================================================
    // == END OF CHATS COLLECTION RULES ==
    // ================================================================================

    // ================================================================================
    // == FOLLOW REQUESTS COLLECTION RULES ==
    // ================================================================================
   match /followRequests/{requestId} {
      allow read: if request.auth != null &&
                    (request.auth.uid == resource.data.requesterId || request.auth.uid == resource.data.recipientId);

      allow create: if request.auth != null &&
                     request.auth.uid == request.resource.data.requesterId &&
                     request.resource.data.requesterId == requestId.split('_')[0] &&
                     request.resource.data.recipientId == requestId.split('_')[1] &&
                     request.resource.data.status == 'accepted' &&
                     request.resource.data.requesterId != request.resource.data.recipientId;

      allow update: if request.auth != null &&
                     (
                       (
                         request.auth.uid == resource.data.recipientId &&
                         resource.data.status == 'pending' &&
                         (request.resource.data.status == 'accepted' || request.resource.data.status == 'declined') &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                       ) ||
                       (
                         request.auth.uid == resource.data.requesterId &&
                         isProfileEffectivelyPublic(resource.data.recipientId) &&
                         request.resource.data.status == 'accepted' &&
                         resource.data.status != 'accepted' &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                       )
                     );

      allow delete: if request.auth != null &&
                     (
                       (request.auth.uid == resource.data.requesterId &&
                        (resource.data.status == 'pending' || resource.data.status == 'accepted'))
                       ||
                       (request.auth.uid == resource.data.recipientId &&
                        (resource.data.status == 'declined' || resource.data.status == 'accepted'))
                     );
    }
    // ================================================================================
    // == END OF FOLLOW REQUESTS COLLECTION RULES ==
    // ================================================================================

    // Posts collection
    match /posts/{postId} {
      allow read: if true; // TEMPORARY DIAGNOSTIC RULE

      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.userId &&
                       request.resource.data.userId != null &&
                       (request.resource.data.caption != null || (request.resource.data.isStory == true && request.resource.data.imageUrl != null)) &&
                       request.resource.data.likesCount == 0 &&
                       request.resource.data.commentsCount == 0 &&
                       request.resource.data.authorIsPrivate != null;

      allow update: if request.auth != null &&
                      (
                        (request.auth.uid == resource.data.userId &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likesCount', 'likedBy', 'commentsCount', 'userId', 'createdAt', 'authorIsPrivate'])) ||
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy', 'commentsCount']))
                      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read: if true; // TEMPORARY DIAGNOSTIC RULE

        allow create: if request.auth != null &&
                         request.auth.uid == request.resource.data.userId &&
                         request.resource.data.text != null &&
                         request.resource.data.userId != null;
        allow delete: if request.auth != null &&
                         (request.auth.uid == resource.data.userId ||
                          request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId);
      }
    }

    // Profiles collection
    match /profiles/{userId} {
      allow read: if true; // TEMPORARY DIAGNOSTIC RULE

      allow create: if request.auth != null &&
                       request.auth.uid == userId &&
                       request.resource.data.uid == userId &&
                       request.resource.data.email != null &&
                       request.resource.data.displayName != null &&
                       request.resource.data.username != null &&
                       request.resource.data.followersCount == 0 &&
                       request.resource.data.followingCount == 0 &&
                       request.resource.data.isPrivate == false;

      allow update: if request.auth != null && request.auth.uid == userId &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'email']) &&
                       (
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followingCount']) ||
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount']) ||
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['followersCount', 'followingCount'])
                       );

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Notifications collection
    match /notifications/{notificationId} {
        allow read, update: if request.auth != null && request.auth.uid == resource.data.recipientId;
        allow delete: if request.auth != null && request.auth.uid == resource.data.recipientId;

        allow create: if request.auth != null &&
                       request.resource.data.actorId == request.auth.uid &&
                       request.resource.data.actorId != request.resource.data.recipientId &&
                       request.resource.data.type != null &&
                       request.resource.data.recipientId != null &&
                       (
                         ( request.resource.data.type == 'like' &&
                           request.resource.data.postId != null
                         ) ||
                         ( request.resource.data.type == 'comment' &&
                           request.resource.data.postId != null &&
                           request.resource.data.commentText != null
                         ) ||
                         ( request.resource.data.type == 'follow_request' &&
                           request.resource.data.followRequestId != null &&
                           isProfileActuallyPrivate(request.resource.data.recipientId)
                         ) ||
                         ( request.resource.data.type == 'follow_accept' &&
                           request.resource.data.originalFollowRequestId != null
                         )
                       );
    }
  }
}

    