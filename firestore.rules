
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isProfileEffectivelyPublic(userId) {
      // A profile is effectively public if its 'isPrivate' field is false, or 'isPrivate' field doesn't exist.
      // This function should NOT depend on request.auth for basic public profile determination if called from a rule path that might be unauthenticated.
      let profileDoc = get(/databases/$(database)/documents/profiles/$(userId));
      return !exists(/databases/$(database)/documents/profiles/$(userId)) || // Non-existent profile is considered "not private" for this check
             profileDoc.data.isPrivate == false ||
             !('isPrivate' in profileDoc.data);
    }

    function isProfilePrivate(userId) {
      // This accurately checks if a profile exists and is explicitly set to private.
      return exists(/databases/$(database)/documents/profiles/$(userId)) &&
             get(/databases/$(database)/documents/profiles/$(userId)).data.isPrivate == true;
    }

    function isAcceptedFollower(profileOwnerId, requesterId) {
      let followDocId = requesterId + '_' + profileOwnerId;
      // This function inherently requires an authenticated requester to check their own follow status.
      return request.auth != null && requesterId == request.auth.uid &&
             exists(/databases/$(database)/documents/followRequests/$(followDocId)) &&
             get(/databases/$(database)/documents/followRequests/$(followDocId)).data.status == 'accepted' &&
             get(/databases/$(database)/documents/followRequests/$(followDocId)).data.requesterId == requesterId &&
             get(/databases/$(database)/documents/followRequests/$(followDocId)).data.recipientId == profileOwnerId;
    }
    // End of Helper Functions

    // ================================================================================
    // == CHATS COLLECTION RULES ==
    // ================================================================================
    match /chats/{chatId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.userIds);
      allow create: if request.auth != null &&
                       request.auth.uid in request.resource.data.userIds &&
                       request.resource.data.userIds.size() == 2 &&
                       request.resource.data.userDetails[request.resource.data.userIds[0]] != null &&
                       request.resource.data.userDetails[request.resource.data.userIds[1]] != null;
      allow update: if request.auth != null && request.auth.uid in resource.data.userIds;

      match /messages/{messageId} {
        allow read: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.userIds.hasAny([request.auth.uid]);
        allow create: if request.auth != null &&
                         request.auth.uid == request.resource.data.senderId &&
                         get(/databases/$(database)/documents/chats/$(chatId)).data.userIds.hasAny([request.auth.uid]) &&
                         (request.resource.data.text != null || request.resource.data.imageUrl != null);
        allow delete: if request.auth != null &&
                         request.auth.uid == resource.data.senderId &&
                         get(/databases/$(database)/documents/chats/$(chatId)).data.userIds.hasAny([request.auth.uid]);
      }
    }
    // ================================================================================
    // == END OF CHATS COLLECTION RULES ==
    // ================================================================================

    // ================================================================================
    // == FOLLOW REQUESTS COLLECTION RULES ==
    // ================================================================================
    match /followRequests/{requestId} {
      allow read: if request.auth != null &&
                    (request.auth.uid == resource.data.requesterId || request.auth.uid == resource.data.recipientId);

      allow create: if request.auth != null &&
                     request.auth.uid == request.resource.data.requesterId && // Requester must be the authenticated user
                     request.resource.data.requesterId != request.resource.data.recipientId && // Cannot follow self
                     // Required fields must be present
                     request.resource.data.requesterId != null &&
                     request.resource.data.recipientId != null &&
                     request.resource.data.status != null &&
                     // Logic based on target profile privacy (Client sends 'pending' for private, 'accepted' for public)
                     (
                       (isProfilePrivate(request.resource.data.recipientId) && request.resource.data.status == 'pending') ||
                       (isProfileEffectivelyPublic(request.resource.data.recipientId) && request.resource.data.status == 'accepted')
                     );

      allow update: if request.auth != null &&
                     ( // Recipient accepting/declining a pending request
                       (
                         request.auth.uid == resource.data.recipientId &&
                         resource.data.status == 'pending' &&
                         (request.resource.data.status == 'accepted' || request.resource.data.status == 'declined') &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                       ) ||
                       // Requester (owner of doc) updating their own request status - e.g., if target profile becomes public
                       (
                         request.auth.uid == resource.data.requesterId &&
                         isProfileEffectivelyPublic(resource.data.recipientId) &&
                         request.resource.data.status == 'accepted' && // Target status is accepted
                         resource.data.status != 'accepted' && // Current status was not accepted
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                       )
                     );

      allow delete: if request.auth != null &&
                     ( // Requester can delete their 'pending' or 'accepted' (unfollow) request
                       (request.auth.uid == resource.data.requesterId && (resource.data.status == 'pending' || resource.data.status == 'accepted'))
                       || // Recipient can delete a 'declined' or 'accepted' request (if they remove a follower - less common from client)
                       (request.auth.uid == resource.data.recipientId && (resource.data.status == 'declined' || resource.data.status == 'accepted'))
                     );
    }
    // ================================================================================
    // == END OF FOLLOW REQUESTS COLLECTION RULES ==
    // ================================================================================

    // Posts collection
    match /posts/{postId} {
      allow read: if
        // Case 1: Post is explicitly marked public AND author's profile is effectively public (works even if request.auth is null)
        ( resource.data.authorIsPrivate == false && isProfileEffectivelyPublic(resource.data.userId) ) ||
        // Case 2: Current user is the author of the post (requires auth)
        ( request.auth != null && request.auth.uid == resource.data.userId ) ||
        // Case 3: Post's author's profile is private, and current user is an accepted follower (requires auth)
        ( resource.data.authorIsPrivate == true &&
          isProfilePrivate(resource.data.userId) && // Ensures author's profile is actually private
          request.auth != null &&
          isAcceptedFollower(resource.data.userId, request.auth.uid)
        );

      allow create: if request.auth != null &&
                       request.auth.uid == request.resource.data.userId &&
                       request.resource.data.userId != null &&
                       request.resource.data.caption != null && // Assuming caption is mandatory for non-story posts or stories with text
                       request.resource.data.likesCount == 0 &&
                       request.resource.data.commentsCount == 0 &&
                       // Set authorIsPrivate based on the creator's current profile status
                       request.resource.data.authorIsPrivate == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.isPrivate;

      allow update: if request.auth != null &&
                      (
                        // Owner can update specific fields, but NOT counters directly or sensitive fields
                        (request.auth.uid == resource.data.userId &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likesCount', 'likedBy', 'commentsCount', 'userId', 'createdAt', 'authorIsPrivate'])) ||
                        // Anyone authenticated can update like/comment counters (usually via increments validated by client logic)
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy', 'commentsCount']))
                      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read: if true; // If post is readable, comments are readable. Consider further restricting if needed.
        allow create: if request.auth != null &&
                         request.auth.uid == request.resource.data.userId && // Commenter is the authenticated user
                         request.resource.data.userId != null &&
                         request.resource.data.text != null;
        allow delete: if request.auth != null &&
                         (request.auth.uid == resource.data.userId || // Comment owner
                          request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId); // Post owner
      }
    }

    // Profiles collection
    match /profiles/{userId} {
      allow read: if (isProfileEffectivelyPublic(userId)) || (request.auth != null);

      allow create: if request.auth != null &&
                       request.auth.uid == userId && // User can only create their own profile doc
                       request.resource.data.uid == userId &&
                       request.resource.data.email != null &&
                       request.resource.data.displayName != null &&
                       request.resource.data.username != null &&
                       request.resource.data.followersCount == 0 &&
                       request.resource.data.followingCount == 0 &&
                       request.resource.data.isPrivate == false; // New profiles default to public

      allow update: if request.auth != null && request.auth.uid == userId &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'email']) && // Cannot change uid or email
                       // Allow owner to update their own followingCount (e.g., by increment(1) or decrement(1))
                       ( (resource.data.followingCount == null || request.resource.data.followingCount == resource.data.followingCount + 1 || request.resource.data.followingCount == resource.data.followingCount - 1) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followingCount'])
                       ) ||
                       // Allow owner to update their own followersCount (e.g., by increment(1) or decrement(1) - usually by cloud function, but rule allows owner)
                       ( (resource.data.followersCount == null || request.resource.data.followersCount == resource.data.followersCount + 1 || request.resource.data.followersCount == resource.data.followersCount - 1) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount'])
                       ) ||
                       // Allow owner to update other allowed fields (bio, displayName, photoURL, coverPhotoURL, isPrivate, username)
                       ( !request.resource.data.diff(resource.data).affectedKeys().hasAny(['followersCount', 'followingCount']) );


      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Notifications collection
    match /notifications/{notificationId} {
        allow read, update: if request.auth != null && request.auth.uid == resource.data.recipientId;
        allow delete: if request.auth != null && request.auth.uid == resource.data.recipientId;

        allow create: if request.auth != null &&
                       request.resource.data.actorId == request.auth.uid && // The actor creating the notification must be the authenticated user
                       request.resource.data.actorId != request.resource.data.recipientId && // Cannot send notification to oneself
                       request.resource.data.type != null && // Type field is required
                       request.resource.data.recipientId != null && // RecipientId field is required
                       ( // Type-specific field validation
                         ( request.resource.data.type == 'like' && request.resource.data.postId != null ) ||
                         ( request.resource.data.type == 'comment' && request.resource.data.postId != null && request.resource.data.commentText != null ) ||
                         ( request.resource.data.type == 'follow_request' && request.resource.data.followRequestId != null && isProfilePrivate(request.resource.data.recipientId) ) ||
                         ( request.resource.data.type == 'follow_accept' && request.resource.data.originalFollowRequestId != null )
                       );
    }
  }
}
