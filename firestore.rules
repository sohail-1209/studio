
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a profile is private
    function isProfilePrivate(userId) {
      return exists(/databases/$(database)/documents/profiles/$(userId)) &&
             get(/databases/$(database)/documents/profiles/$(userId)).data.isPrivate == true;
    }

    // Helper function to check if a profile is effectively public
    // (explicitly public, or isPrivate field missing, or profile doesn't exist - latter is less likely for target)
    function isProfileEffectivelyPublic(userId) {
      let profileDoc = get(/databases/$(database)/documents/profiles/$(userId));
      return !exists(/databases/$(database)/documents/profiles/$(userId)) ||
             !('isPrivate' in profileDoc.data) || // Field doesn't exist
             profileDoc.data.isPrivate == false;  // Explicitly public
    }

    // Helper function to check if current user is an accepted follower of targetUser
    function isAcceptedFollower(targetUserId) {
      return request.auth != null && exists(/databases/$(database)/documents/followRequests/$(request.auth.uid)_$(targetUserId)) &&
             get(/databases/$(database)/documents/followRequests/$(request.auth.uid)_$(targetUserId)).data.status == 'accepted';
    }

    match /profiles/{userId} {
      allow read: if true; // Profiles are generally public to read basic info
      allow create: if request.auth != null && request.auth.uid == userId; // User can create their own profile
      allow update: if request.auth != null && request.auth.uid == userId &&
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'bio', 'photoURL', 'coverPhotoURL', 'username', 'followersCount', 'followingCount', 'isPrivate'])); // Owner can update specific fields
      allow delete: if request.auth != null && request.auth.uid == userId; // User can delete their own profile
    }

    match /posts/{postId} {
      allow read: if
        // Public post from a public author
        (isProfileEffectivelyPublic(resource.data.userId) && resource.data.authorIsPrivate == false) ||
        // Own post
        (request.auth != null && request.auth.uid == resource.data.userId) ||
        // Post from a private author the current user follows
        (request.auth != null && isProfilePrivate(resource.data.userId) && resource.data.authorIsPrivate == true && isAcceptedFollower(resource.data.userId));

      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId; // User can create their own posts
      allow update: if request.auth != null &&
                       // Owner can update caption, image, video, story status
                       (request.auth.uid == resource.data.userId &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'imageUrl', 'imagePath', 'videoUrl', 'isStory', 'dataAiHint', 'authorIsPrivate'])) ||
                       // Any authenticated user can update like/comment counts (interaction fields)
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy', 'commentsCount']));
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId; // User can delete their own posts

      match /comments/{commentId} {
        allow read: if true; // Comments are generally public if the post is viewable
        allow create: if request.auth != null; // Any authenticated user can comment
        allow delete: if request.auth != null &&
                         (request.auth.uid == resource.data.userId || // Comment owner
                          (exists(/databases/$(database)/documents/posts/$(postId)) && request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId) // Post owner
                         );
      }
    }

    match /followRequests/{requestId} {
      allow read: if request.auth != null && (
                    request.auth.uid == resource.data.requesterId ||
                    request.auth.uid == resource.data.recipientId
                  );

      allow create: if
        request.auth != null &&
        request.auth.uid == request.resource.data.requesterId &&
        request.resource.data.requesterId != request.resource.data.recipientId &&
        (
          // Requesting to follow a private profile
          (isProfilePrivate(request.resource.data.recipientId) && request.resource.data.status == 'pending')
          ||
          // Directly following a public profile
          (isProfileEffectivelyPublic(request.resource.data.recipientId) && request.resource.data.status == 'accepted')
        );

      allow update: if request.auth != null &&
        // Recipient accepting/declining a pending request
        ( (request.auth.uid == resource.data.recipientId &&
           resource.data.status == 'pending' &&
           (request.resource.data.status == 'accepted' || request.resource.data.status == 'declined') &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
        // Requester re-following a public profile (e.g., after unfollowing or if request was 'declined' by system/error)
          (request.auth.uid == resource.data.requesterId &&
           isProfileEffectivelyPublic(resource.data.recipientId) &&
           request.resource.data.status == 'accepted' &&
           resource.data.status != 'accepted' && // Can only change TO accepted if not already accepted
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if request.auth != null && request.auth.uid == resource.data.requesterId; // Requester can delete (cancel/unfollow)
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.recipientId;
      allow create: if request.auth != null &&
        // Actor is self
        request.auth.uid == request.resource.data.actorId &&
        // Not sending notification to self
        request.resource.data.actorId != request.resource.data.recipientId &&
        // Type specific conditions
        (
          (request.resource.data.type == 'like' || request.resource.data.type == 'comment') ||
          (request.resource.data.type == 'follow_request' && isProfilePrivate(request.resource.data.recipientId)) || // Only send request notif if target is private
          (request.resource.data.type == 'follow_accept') // follow_accept sent by recipient of original request or by system for public follow
        );
      allow update: if request.auth != null && request.auth.uid == resource.data.recipientId &&
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'actionTaken'])); // Recipient can mark as read or update action
      allow delete: if request.auth != null && (request.auth.uid == resource.data.recipientId || request.auth.uid == resource.data.actorId); // Recipient or actor can delete (e.g., for cleanup)
    }

    match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.userIds;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.userIds; // User creating chat must be part of it
      allow update: if request.auth != null && request.auth.uid in resource.data.userIds; // Participants can update chat (e.g. last message)

      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.userIds;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.userIds;
        allow delete: if request.auth != null && request.auth.uid == resource.data.senderId; // Sender can delete their own message
      }
    }
  }
}
