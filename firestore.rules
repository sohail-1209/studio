
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isProfilePrivate(userId) {
      return exists(/databases/$(database)/documents/profiles/$(userId)) &&
             get(/databases/$(database)/documents/profiles/$(userId)).data.isPrivate == true;
    }

    function isProfileEffectivelyPublic(userId) {
      // Treats profile as public if it doesn't exist, or isPrivate is false, or isPrivate field is missing
      return !exists(/databases/$(database)/documents/profiles/$(userId)) ||
             get(/databases/$(database)/documents/profiles/$(userId)).data.isPrivate == false ||
             !('isPrivate' in get(/databases/$(database)/documents/profiles/$(userId)).data);
    }

    function isAcceptedFollower(profileUserId, requesterId) {
      // Check if a 'followRequests' document exists where requesterId follows profileUserId and status is 'accepted'
      return exists(/databases/$(database)/documents/followRequests/$(requesterId + '_' + profileUserId)) &&
             get(/databases/$(database)/documents/followRequests/$(requesterId + '_' + profileUserId)).data.status == 'accepted';
      // Or the other way around if the document ID structure is recipient_requester
      // || (exists(/databases/$(database)/documents/followRequests/$(profileUserId + '_' + requesterId)) &&
      //     get(/databases/$(database)/documents/followRequests/$(profileUserId + '_' + requesterId)).data.status == 'accepted');
    }

    // ================================================================================
    // == CHATS COLLECTION RULES ==
    // ================================================================================
    match /chats/{chatId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.userIds);
      allow create: if request.auth != null && request.auth.uid in request.resource.data.userIds && request.resource.data.userIds.size() == 2;
      allow update: if request.auth != null && request.auth.uid in resource.data.userIds;
      // allow delete: if request.auth != null && request.auth.uid in resource.data.userIds; // Optional

      match /messages/{messageId} {
        allow read: if request.auth != null && 
                       exists(/databases/$(database)/documents/chats/$(chatId)) &&
                       request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.userIds;
        allow create: if request.auth != null &&
                         request.auth.uid == request.resource.data.senderId &&
                         exists(/databases/$(database)/documents/chats/$(chatId)) &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.userIds;
        allow delete: if request.auth != null &&
                         request.auth.uid == resource.data.senderId && // Only sender can delete their message
                         exists(/databases/$(database)/documents/chats/$(chatId)) &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.userIds;
      }
    }
    // ================================================================================
    // == END OF CHATS COLLECTION RULES ==
    // ================================================================================

    // ================================================================================
    // == FOLLOW REQUESTS COLLECTION RULES ==
    // ================================================================================
    match /followRequests/{requestId} {
      allow read: if request.auth != null &&
                    (request.auth.uid == resource.data.requesterId || request.auth.uid == resource.data.recipientId);

      allow create: if
        request.auth != null &&
        request.auth.uid == request.resource.data.requesterId &&
        request.resource.data.requesterId != request.resource.data.recipientId &&
        (
          // Case 1: Target profile is private, request status must be 'pending'.
          (
            isProfilePrivate(request.resource.data.recipientId) &&
            request.resource.data.status == 'pending'
          )
          ||
          // Case 2: Target profile is public, request status must be 'accepted'.
          (
            isProfileEffectivelyPublic(request.resource.data.recipientId) &&
            request.resource.data.status == 'accepted'
          )
        ) &&
        // Ensure required fields are present
        request.resource.data.keys().hasAll(['requesterId', 'recipientId', 'status', 'createdAt', 'updatedAt']);


      allow update: if
        request.auth != null &&
        // Scenario 1: Recipient is acting on a PENDING request
        (
          request.auth.uid == resource.data.recipientId &&
          resource.data.status == 'pending' &&
          (request.resource.data.status == 'accepted' || request.resource.data.status == 'declined') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
        ||
        // Scenario 2: Requester is re-following a PUBLIC profile, or updating a 'pending' to 'accepted' if profile became public.
        // This allows changing a 'declined' (or other non-'accepted') status to 'accepted' for a public profile.
        (
          request.auth.uid == resource.data.requesterId &&
          isProfileEffectivelyPublic(resource.data.recipientId) && // Target must be public
          request.resource.data.status == 'accepted' &&            // New status is 'accepted'
          resource.data.status != 'accepted' &&                    // Old status was not 'accepted'
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        );

      allow delete: if request.auth != null &&
                     (
                       // Requester can delete their request if it's 'pending', 'declined', OR 'accepted' (for unfollow)
                       (request.auth.uid == resource.data.requesterId &&
                        (resource.data.status == 'pending' || resource.data.status == 'declined' || resource.data.status == 'accepted'))
                       ||
                       // Recipient can delete a request they've processed ('accepted' or 'declined')
                       (request.auth.uid == resource.data.recipientId &&
                        (resource.data.status == 'accepted' || resource.data.status == 'declined'))
                     );
    }
    // ================================================================================
    // == END OF FOLLOW REQUESTS COLLECTION RULES ==
    // ================================================================================

    // ================================================================================
    // == POSTS COLLECTION RULES ==
    // ================================================================================
    match /posts/{postId} {
      allow read: if
        // Public posts are always readable if post exists and author profile is public
        (get(/databases/$(database)/documents/posts/$(postId)).data.authorIsPrivate == false) ||
        // Private posts readable by author or accepted follower
        (
          request.auth != null &&
          (
            request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId || // Author
            (
              get(/databases/$(database)/documents/posts/$(postId)).data.authorIsPrivate == true &&
              isAcceptedFollower(get(/databases/$(database)/documents/posts/$(postId)).data.userId, request.auth.uid) // Accepted follower
            )
          )
        );

      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId &&
                       request.resource.data.keys().hasAll(['userId', 'caption', 'likesCount', 'commentsCount', 'createdAt', 'authorIsPrivate']);


      allow update: if request.auth != null &&
                      (
                        // Owner can update their post's caption, imageUrl, videoUrl, isStory, dataAiHint, authorIsPrivate (if they change their profile privacy)
                        ( request.auth.uid == resource.data.userId &&
                          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likesCount', 'likedBy', 'commentsCount', 'userId', 'createdAt'])
                        ) ||
                        // Any authenticated user can update likesCount and likedBy (for liking/unliking)
                        // CommentsCount should be updated by a Cloud Function or via comment creation/deletion rules.
                        ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy']) &&
                          request.auth != null // Ensure user is authenticated to like
                        )
                      );

      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read: if true; // Comments are public if the post is readable. Post read rule handles privacy.
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId &&
                         request.resource.data.keys().hasAll(['userId', 'text', 'createdAt']);
        allow delete: if request.auth != null &&
                         (
                           request.auth.uid == resource.data.userId || // Comment owner
                           request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId // Post owner
                         );
      }
    }
    // ================================================================================
    // == END OF POSTS COLLECTION RULES ==
    // ================================================================================

    // ================================================================================
    // == PROFILES COLLECTION RULES ==
    // ================================================================================
    match /profiles/{userId} {
      allow read: if true; // Profiles are generally public to read basic info

      allow create: if request.auth != null && request.auth.uid == userId &&
                       // Ensure all required fields are present on creation
                       request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'username', 'bio', 'followersCount', 'followingCount', 'isPrivate']);

      allow update: if request.auth != null && request.auth.uid == userId &&
                      // Prevent UID and email from being changed
                      !('uid' in request.resource.data) &&
                      !('email' in request.resource.data) &&
                      // Allow owner to update their own counters only if it's an increment/decrement by 1.
                      // For followersCount, this should ideally be a Cloud Function.
                      // For followingCount, client can increment/decrement its own.
                      (
                        (
                          // Check if only followingCount is changing and it's by +/- 1
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followingCount']) &&
                          (request.resource.data.followingCount == resource.data.followingCount + 1 || request.resource.data.followingCount == resource.data.followingCount - 1)
                        ) ||
                        (
                          // Allow updating other fields except counters if not updating counters in same op
                           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['followersCount', 'followingCount'])
                        )
                      );

      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    // ================================================================================
    // == END OF PROFILES COLLECTION RULES ==
    // ================================================================================

    // ================================================================================
    // == NOTIFICATIONS COLLECTION RULES ==
    // ================================================================================
    match /notifications/{notificationId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.recipientId; // Recipient can read/update (mark as read)
      allow delete: if request.auth != null && (request.auth.uid == resource.data.recipientId || request.auth.uid == resource.data.actorId); // Recipient or Actor can delete

      allow create: if request.auth != null &&
                       request.resource.data.actorId == request.auth.uid && // The actor creating the notification must be the authenticated user
                       request.resource.data.actorId != request.resource.data.recipientId && // Cannot send notification to oneself
                       (
                         ( request.resource.data.type == 'like' &&
                           request.resource.data.postId != null &&
                           exists(/databases/$(database)/documents/posts/$(request.resource.data.postId)) // Post must exist
                         ) ||
                         ( request.resource.data.type == 'comment' &&
                           request.resource.data.postId != null &&
                           request.resource.data.commentText != null &&
                           exists(/databases/$(database)/documents/posts/$(request.resource.data.postId)) // Post must exist
                         ) ||
                         ( request.resource.data.type == 'follow_request' &&
                           request.resource.data.followRequestId != null &&
                           isProfilePrivate(request.resource.data.recipientId) // Only send 'follow_request' notif if target is private
                         ) ||
                         ( request.resource.data.type == 'follow_accept' &&
                           request.resource.data.originalFollowRequestId != null
                           // No need to check if original recipient was private, accept can be for public auto-follow too
                         )
                       ) &&
                       // Ensure required fields for all types are present
                        request.resource.data.keys().hasAll(['recipientId', 'actorId', 'type', 'createdAt', 'isRead']);
    }
    // ================================================================================
    // == END OF NOTIFICATIONS COLLECTION RULES ==
    // ================================================================================
  }
}

    