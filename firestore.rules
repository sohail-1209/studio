
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================================
    // == CHATS COLLECTION RULES ==
    // ================================================================================
    match /chats/{chatId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.userIds);
      allow create: if request.auth != null && request.auth.uid in request.resource.data.userIds;
      allow update: if request.auth != null && request.auth.uid in resource.data.userIds;
      // allow delete: if request.auth != null && request.auth.uid in resource.data.userIds; // Optional

      match /messages/{messageId} {
        allow read: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.userIds.hasAny([request.auth.uid]);
        allow create: if request.auth != null &&
                         request.auth.uid == request.resource.data.senderId &&
                         get(/databases/$(database)/documents/chats/$(chatId)).data.userIds.hasAny([request.auth.uid]);
        allow delete: if request.auth != null &&
                         request.auth.uid == resource.data.senderId &&
                         get(/databases/$(database)/documents/chats/$(chatId)).data.userIds.hasAny([request.auth.uid]);
      }
    }
    // ================================================================================
    // == END OF CHATS COLLECTION RULES ==
    // ================================================================================

    // ================================================================================
    // == FOLLOW REQUESTS COLLECTION RULES ==
    // ================================================================================
    match /followRequests/{requestId} {
      allow read: if request.auth != null &&
                    (request.auth.uid == resource.data.requesterId || request.auth.uid == resource.data.recipientId);

      allow create: if
        request.auth != null &&
        request.auth.uid == request.resource.data.requesterId &&
        request.resource.data.requesterId != request.resource.data.recipientId &&
        (
          // Case 1: Recipient profile is explicitly private
          (
            exists(/databases/$(database)/documents/profiles/$(request.resource.data.recipientId)) &&
            get(/databases/$(database)/documents/profiles/$(request.resource.data.recipientId)).data.isPrivate == true &&
            request.resource.data.status == 'pending'
          )
          ||
          // Case 2: Recipient profile is not explicitly private (public or field missing)
          (
            (
              !exists(/databases/$(database)/documents/profiles/$(request.resource.data.recipientId)) ||
              get(/databases/$(database)/documents/profiles/$(request.resource.data.recipientId)).data.isPrivate != true
            ) &&
            request.resource.data.status == 'accepted'
          )
        );

      allow update: if request.auth != null &&
                     request.auth.uid == resource.data.recipientId &&
                     request.resource.data.status != resource.data.status &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if request.auth != null &&
                     (
                       (request.auth.uid == resource.data.requesterId &&
                        (resource.data.status == 'pending' || resource.data.status == 'declined' || resource.data.status == 'accepted'))
                       ||
                       (request.auth.uid == resource.data.recipientId &&
                        (resource.data.status == 'accepted' || resource.data.status == 'declined'))
                     );
    }
    // ================================================================================
    // == END OF FOLLOW REQUESTS COLLECTION RULES ==
    // ================================================================================

    // ================================================================================
    // == POSTS COLLECTION RULES ==
    // ================================================================================
    match /posts/{postId} {
      allow read: if
        (request.auth != null && resource.data.userId == request.auth.uid) || // Author can always read
        (resource.data.authorIsPrivate == false || resource.data.authorIsPrivate == null) || // Public post or old post
        (
          resource.data.authorIsPrivate == true &&
          request.auth != null && // Ensure user is authenticated before checking follow status
          exists(/databases/$(database)/documents/followRequests/$(request.auth.uid)_$(resource.data.userId)) &&
          get(/databases/$(database)/documents/followRequests/$(request.auth.uid)_$(resource.data.userId)).data.status == 'accepted'
        );

      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;

      allow update: if request.auth != null &&
                      (
                        // Owner can update their post (except interaction counts)
                        (request.auth.uid == resource.data.userId &&
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likesCount', 'likedBy', 'commentsCount', 'userId', 'createdAt', 'authorIsPrivate'])) ||
                        // Any authenticated user can update interaction counts (liking, unliking)
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'likedBy']) ||
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount'])) // Separate for comment increment
                      );

      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read: if true; // Comments are public if the post is readable
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
        allow delete: if request.auth != null &&
                         ( request.auth.uid == resource.data.userId || // Comment author
                           request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.userId ); // Post author
      }
    }
    // ================================================================================
    // == END OF POSTS COLLECTION RULES ==
    // ================================================================================

    // ================================================================================
    // == PROFILES COLLECTION RULES ==
    // ================================================================================
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null &&
                     (
                       (request.auth.uid == userId &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'followersCount', 'followingCount']))
                       ||
                       (
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount']) && request.auth.uid == userId) ||
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followingCount']) && request.auth.uid == userId)
                       )
                     );
    }
    // ================================================================================
    // == END OF PROFILES COLLECTION RULES ==
    // ================================================================================

    // ================================================================================
    // == NOTIFICATIONS COLLECTION RULES ==
    // ================================================================================
    match /notifications/{notificationId} {
        allow read, update: if request.auth != null && request.auth.uid == resource.data.recipientId;
        // Allow deletion if user is recipient OR actor (for account deletion cleanup)
        allow delete: if request.auth != null &&
                         (request.auth.uid == resource.data.recipientId || request.auth.uid == resource.data.actorId);

        allow create: if request.auth != null &&
                       request.resource.data.actorId == request.auth.uid &&
                       request.resource.data.actorId != request.resource.data.recipientId &&
                       (
                         ( request.resource.data.type == 'like' &&
                           request.resource.data.postId != null
                         ) ||
                         ( request.resource.data.type == 'comment' &&
                           request.resource.data.postId != null &&
                           request.resource.data.commentText != null
                         ) ||
                         ( request.resource.data.type == 'follow_request' &&
                           request.resource.data.followRequestId != null
                         ) ||
                         ( request.resource.data.type == 'follow_accept' &&
                           request.resource.data.originalFollowRequestId != null
                         )
                       );
    }
    // ================================================================================
    // == END OF NOTIFICATIONS COLLECTION RULES ==
    // ================================================================================
  }
}
